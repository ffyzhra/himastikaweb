<IfModule mod_rewrite.c>
    RewriteEngine On
    # No RewriteBase: works both at a domain root (http://himastika.test/)
    # and in a subfolder (http://localhost/himastika/).
    # "index.php?/" (not "index.php/") so it also works when PHP runs as
    # FastCGI/CGI (Laragon), which otherwise answers "No input file specified".
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>
