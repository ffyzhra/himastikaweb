<IfModule mod_rewrite.c>
    RewriteEngine On
    # No RewriteBase: works both at a domain root (http://himastika.test/)
    # and in a subfolder (http://localhost/himastika/).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
